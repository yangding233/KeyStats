<Window x:Class="KeyStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KeyStats.App.Controls"
        Title="KeyStats · 键盘与鼠标使用统计"
        Icon="Assets/KeyStats.ico"
        Width="1280" Height="860" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KeyStats" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="键盘与鼠标使用频率统计" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 后自动启动" Focusable="False"
                              VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" />
                    <Button x:Name="StartupRepairButton" Content="更新自启动位置" Style="{StaticResource SecondaryButtonStyle}"
                            Focusable="False" Padding="10,5" FontWeight="Normal" Margin="0,0,16,0"
                            Visibility="Collapsed" Click="StartupRepairButton_Click" />
                    <Border x:Name="StatusBadge" Background="#E9F7EF" CornerRadius="14" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#38A85A" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusText" Text="正在采集" Foreground="#267C42" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="24,16,24,12" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="范围" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox x:Name="RangePresetComboBox" Width="112" Height="30" SelectionChanged="RangePresetComboBox_SelectionChanged">
                        <ComboBoxItem Content="今天" Tag="Today" IsSelected="True" />
                        <ComboBoxItem Content="最近 10 分钟" Tag="Recent10" />
                        <ComboBoxItem Content="最近 7 天" Tag="Recent7Days" />
                        <ComboBoxItem Content="最近 30 天" Tag="Recent30Days" />
                        <ComboBoxItem Content="全部" Tag="All" />
                        <ComboBoxItem Content="自定义" Tag="Custom" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="开始日期" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <DatePicker x:Name="StartDatePicker" Width="128" Height="30" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="时间" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox x:Name="StartTimeComboBox" Width="74" Height="30" IsEditable="True" IsTextSearchEnabled="False" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                    <TextBlock Text="结束日期" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <DatePicker x:Name="EndDatePicker" Width="128" Height="30" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,12,0">
                    <TextBlock Text="时间（不含）" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox x:Name="EndTimeComboBox" Width="74" Height="30" IsEditable="True" IsTextSearchEnabled="False" />
                </StackPanel>
                <CheckBox x:Name="TenMinuteSnapCheckBox" Grid.Column="5" Content="10 分钟吸附" IsChecked="True" Focusable="False" VerticalAlignment="Bottom" Margin="0,0,12,7" />
                <StackPanel Grid.Column="6" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <Button x:Name="ApplyRangeButton" Content="应用范围" Style="{StaticResource PrimaryButtonStyle}" Focusable="False" Padding="14,7" Click="ApplyRangeButton_Click" />
                    <TextBlock x:Name="RangeValidationText" VerticalAlignment="Center" Foreground="#A45A18" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="7" Margin="12,0,0,0">
                    <TextBlock Text="色阶" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,4" />
                    <ComboBox x:Name="ScaleModeComboBox" Width="104" Height="30" SelectionChanged="ScaleModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="平方根" Tag="SquareRoot" IsSelected="True" />
                        <ComboBoxItem Content="线性" Tag="Linear" />
                    </ComboBox>
                </StackPanel>
                <Grid Grid.Row="1" Grid.ColumnSpan="8" Margin="0,9,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="时段热力图 · 所选范围按每天相同的 10 分钟时段汇总"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                        <TextBlock x:Name="DailyTimelineSummaryText" Grid.Column="1" Text="暂无输入"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                    </Grid>
                    <controls:TenMinuteTimelineControl x:Name="DailyTimeline" Grid.Row="1" Margin="0,3,0,0" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="本次运行" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="TotalCountText" Grid.Row="1" Text="0" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock x:Name="TotalHistoryText" Grid.Row="2" Text="总数量：正在加载…" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0" />
                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button x:Name="PauseButton" Content="暂停采集" Style="{StaticResource PrimaryButtonStyle}" Focusable="False" Padding="14,7" Click="PauseButton_Click" />
                        <Button Content="清零本次显示" Style="{StaticResource SecondaryButtonStyle}" Focusable="False" Padding="14,7" Margin="7,0,0,0" Click="ClearButton_Click" />
                        <Button x:Name="SaveNowButton" Content="立即保存" Style="{StaticResource SecondaryButtonStyle}" Focusable="False" Padding="14,7" IsEnabled="False" Margin="7,0,0,0" Click="SaveNowButton_Click" />
                        <Button x:Name="ExportButton" Content="导出 CSV" Style="{StaticResource SecondaryButtonStyle}" Focusable="False" Padding="14,7" IsEnabled="False" Margin="7,0,0,0" Click="ExportButton_Click" />
                        <Button x:Name="ExitButton" Content="退出 KeyStats" Style="{StaticResource SecondaryButtonStyle}" Focusable="False" Padding="14,7" Margin="7,0,0,0" Click="ExitButton_Click" />
                        <TextBlock Text="关闭窗口后仍在托盘运行；若托盘看不到图标，请点任务栏的 ^ 展开"
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="当前按下中的键或按钮" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="PressedKeysText" Grid.Row="1" Text="无" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,7" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="LastInputText" Text="等待输入…" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="UnknownInputText" Text="未识别输入：0" Foreground="#A45A18" Margin="0,3,0,0" />
                        <TextBlock x:Name="CollectionHealthText" Text="采集健康度：正在初始化…" Foreground="#526474" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="StartupHintText" Foreground="#A45A18" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="StorageStatusText" Text="本地数据：正在初始化…" Foreground="#526474" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="24,0,24,16" Padding="0">
            <TabControl BorderThickness="0" Background="Transparent">
                <TabItem Header="键盘热力图">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <controls:KeyboardHeatmapControl x:Name="HeatmapKeyboard" MinHeight="260" />
                        <Grid Grid.Row="1" Margin="4,10,4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="0" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,5,0" />
                                <Border Width="18" Height="12" Background="#F7F8FA" BorderBrush="#CED6DF" BorderThickness="1" Margin="0,0,5,0" />
                                <TextBlock Text="低" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,4,0" />
                                <Border Width="160" Height="12" BorderBrush="#CED6DF" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#DAEBF9" Offset="0" />
                                            <GradientStop Color="#5B97D3" Offset="0.58" />
                                            <GradientStop Color="#EB8B39" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="高 · 连续色阶" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="HeatmapRangeText" HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" Text="正在加载范围…" />
                                <TextBlock x:Name="HeatmapTotalText" HorizontalAlignment="Center" FontWeight="SemiBold" Text="所选范围总计：0" />
                            </StackPanel>
                            <TextBlock x:Name="HeatmapUpdatedText" Grid.Column="2" Foreground="{StaticResource SecondaryTextBrush}" Text="尚未更新" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="详细列表">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="所选范围内的按键与按钮" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <CheckBox x:Name="ActiveOnlyCheckBox" Grid.Column="1" Content="只显示有次数或按下中的键" Focusable="False" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" />
                        </Grid>
                        <DataGrid x:Name="KeyGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0,1,0,0"
                                  BorderBrush="{StaticResource BorderBrush}" RowHeaderWidth="0" AlternatingRowBackground="#FAFBFC"
                                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="按键/按钮" Binding="{Binding DisplayName}" Width="2*" />
                                <DataGridTextColumn Header="区域" Binding="{Binding Category}" Width="*" />
                                <DataGridTextColumn Header="次数" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="*" />
                                <DataGridTextColumn Header="状态" Binding="{Binding PressedText}" Width="*" />
                                <DataGridTextColumn Header="按键标识" Binding="{Binding Id}" Width="1.5*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4" Background="#EEF3F8" BorderBrush="#DAE3EC" BorderThickness="0,1,0,0">
            <TextBlock Margin="24,0" VerticalAlignment="Center" Foreground="#526474"
                       Text="所有数据仅保存在本机 · 不记录输入内容、输入顺序、使用中的应用或鼠标位置" />
        </Border>
    </Grid>
</Window>
